# Copy to .env and fill in. The app runs without any of these set:
# submissions are persisted and the email payload is logged to the console.

# --- Database ---------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# --- Email (Resend) ---------------------------------------------------------
# Get a key at https://resend.com/api-keys. When unset, emails are logged
# to the console instead of being sent — nothing is lost, the submission is
# still written to the database.
RESEND_API_KEY=

# Where contact form notifications are delivered.
CONTACT_TO_EMAIL="jourdan@a5partners.com"

# Resend only delivers mail from a domain you have verified on your account.
# Until a5partners.com is verified, use Resend's sandbox sender below — note
# that it can ONLY deliver to the email address that owns the Resend account.
# After verifying the domain, change this to e.g. "A5 Partners <no-reply@a5partners.com>".
CONTACT_FROM_EMAIL="A5 Partners <onboarding@resend.dev>"

# --- Server -----------------------------------------------------------------
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"
