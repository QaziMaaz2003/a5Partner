# Copy to .env.local for local work. All of these are optional.

# Base URL of the NestJS API. When set, contact submissions are proxied to it
# (validated, stored in the database, then emailed).
# Leave UNSET on a Vercel-only deployment — the Next.js route will email via
# Resend directly instead. In development it defaults to http://localhost:3001.
# API_URL="https://your-api-host.example.com"

# Used only on the standalone path (API_URL unset). Without a key the
# submission is logged to the server console and the visitor still sees the
# success message.
RESEND_API_KEY=

CONTACT_TO_EMAIL="jourdan@a5partners.com"

# Resend only delivers from a domain verified on your account. Until
# a5partners.com is verified, keep the sandbox sender below — it can ONLY
# deliver to the address that owns the Resend account.
CONTACT_FROM_EMAIL="A5 Partners <onboarding@resend.dev>"
